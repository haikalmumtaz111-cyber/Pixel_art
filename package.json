{
  "name": "pixel-history-studio",
  "version": "0.1.0",
  "private": true,
  "description": "Studio animasi pixel art berbasis kode untuk film sejarah bergaya retro.",
  "scripts": {
    "check": "node src/render/check-env.cjs",
